rules_version = '2';

// Public arcade leaderboards: anyone can read; new scores can be added but never edited or deleted.
service cloud.firestore {
  match /databases/{database}/documents {

    function knownBoard(board) {
      return board in [
        'pacman', 'snake', 'minesweeper', 'frogger', 'breakout', 'asteroids', 'tetris-tower', 'tetris-marathon', 'shooter',
        'pacman-classic', 'snake-classic', 'frogger-classic', 'breakout-classic', 'asteroids-classic', 'shooter-classic',
        'tetris-sprint', 'tetris-marathon150', 'mines-beginner', 'mines-intermediate', 'mines-expert',
        'klondike-1', 'klondike-3', 'spider-1', 'spider-2', 'spider-4', 'freecell'
      ];
    }

    function validEntry(d) {
      return d.keys().hasOnly(['name', 'score', 'time', 'won', 'createdAt'])
        && d.keys().hasAll(['name', 'score', 'time', 'won', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.name.matches('^[A-Za-z0-9 _.!?\\-]+$')
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.time is number && d.time >= 0 && d.time <= 86400
        && d.won is bool
        && d.createdAt == request.time;
    }

    match /boards/{board}/scores/{entry} {
      allow read: if knownBoard(board);
      allow create: if knownBoard(board) && validEntry(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
