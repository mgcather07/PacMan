rules_version = '2';

// Public arcade leaderboards.
// All writes go through Cloud Functions (functions/index.js), which time each game on the server,
// reject implausible results, keep one best entry per player per board and record play statistics.
// Clients (signed in anonymously, with App Check enforced) can only read.
service cloud.firestore {
  match /databases/{database}/documents {

    // leaderboard entries: boards/{board}/scores/{uid}
    match /boards/{board}/scores/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // lets a player find all of their own entries across boards in one query (scores are public anyway)
    match /{path=**}/scores/{uid} {
      allow read: if true;
    }

    // private player profile: name, daily streak days, play counts
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // runs, stats and config are server-only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
